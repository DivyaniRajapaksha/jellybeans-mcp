# Copy this file to .env and fill in your own values. .env is git-ignored: never commit it.
# Keep real hostnames, URLs and credentials out of this file.

# --- MongoDB Atlas (use a read-only database user) ---
# Connection string from Atlas > Connect > Drivers
MONGODB_URI=
MONGODB_DB=

# --- Server ---
# stdio for local clients (Claude Desktop / Claude Code), http for Streamable HTTP
MCP_TRANSPORT=stdio
LOG_LEVEL=INFO
# Fallback time zone if the database has none (IANA name, e.g. Asia/Colombo)
TIMEZONE=Asia/Colombo
# Allow find_customer to search by phone number (the number then passes through the LLM). Keep false.
ENABLE_PHONE_LOOKUP=false

# --- HTTP + OAuth 2.1 (only needed when MCP_TRANSPORT=http) ---
# Interface and port to listen on
HOST=
PORT=8000
# Public base URL of the deployed server
PUBLIC_URL=
# Auth0 tenant domain
AUTH0_DOMAIN=
# Auth0 API identifier (audience), usually PUBLIC_URL + /mcp
AUTH0_AUDIENCE=
